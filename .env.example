# Configuração do Firebase para o Na Lista
# Substitua com as credenciais do seu projeto do console do Firebase:
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000

# No Firebase Console, ative Authentication > Sign-in method:
# - E-mail/senha
# - Google
# Depois adicione http://localhost:5173 e seu domínio publicado em
# Authentication > Settings > Authorized domains.
